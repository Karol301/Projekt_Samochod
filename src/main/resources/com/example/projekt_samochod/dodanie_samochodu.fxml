<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projekt_samochod.DodanieSamochoduController" spacing="10" alignment="CENTER" prefHeight="800.0" prefWidth="800.0">
    <children>
        <Label text="Dodaj nowy samochód" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

        <!-- Informacje ogólne o samochodzie -->
        <HBox spacing="10" alignment="CENTER">
            <Label text="Nazwa samochodu:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="nazwaSamochoduField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Nr rejestracyjny:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="nrRejestracyjnyField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Waga samochodu:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="wagaSamochoduField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Prędkość maksymalna:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="predkoscSamochoduField" />
        </HBox>

        <!-- Informacje o skrzyni biegów -->
        <Label text="Informacje o skrzyni biegów" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER">
            <Label text="Nazwa skrzyni biegów:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="nazwaSkrzyniField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Cena skrzyni biegów:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="cenaSkrzyniField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Waga skrzyni biegów:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="wagaSkrzyniField" />
        </HBox>

        <!-- Informacje o silniku -->
        <Label text="Informacje o silniku" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER">
            <Label text="Nazwa silnika:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="nazwaSilnikaField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Cena silnika:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="cenaSilnikaField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Waga silnika:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="wagaSilnikaField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Max obroty silnika:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="maxObrotySilnikaField" />
        </HBox>

        <!-- Informacje o sprzęgle -->
        <Label text="Informacje o sprzęgle" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER">
            <Label text="Nazwa sprzęgła:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="nazwaSprzeglaField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Cena sprzęgła:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="cenaSprzeglaField" />
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Label text="Waga sprzęgła:" minWidth="150" alignment="CENTER_RIGHT" />
            <TextField fx:id="wagaSprzeglaField" />
        </HBox>

        <Button fx:id="dodajButton" text="Dodaj" onAction="#dodaj_samochod_accept" maxWidth="150" />
    </children>
</VBox>
